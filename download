  <!-- CONTACT BODY -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">

        <!-- FORM -->
        <div class="form-wrap">
          <h2>Envíenos sus requisitos</h2>
          <form action="https://formspree.io/f/maqgozel" method="POST" class="inquiry-form" id="inquiryForm">

            <!-- Honeypot spam trap -->
            <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="form-row">
              <div class="form-group">
                <label for="name">Su nombre *</label>
                <input type="text" id="name" name="name" required placeholder="Jane Smith" />
              </div>
              <div class="form-group">
                <label for="company">Empresa *</label>
                <input type="text" id="company" name="company" required placeholder="Brand or factory name" />
              </div>
            </div>

            <div class="form-group">
              <label for="email">Email corporativo *</label>
              <input type="email" id="email" name="email" required placeholder="jane@yourcompany.com" />
            </div>

            <div class="form-group">
              <label for="application">Aplicación *</label>
              <select id="application" name="application" required>
                <option value="">Seleccione su producto final</option>
                <option value="footwear-comfort">Calzado de confort/estilo de vida (estilo Birkenstock, sandalias)</option>
                <option value="footwear-other">Otro calzado</option>
                <option value="bags-fashion">Bolsos y accesorios de moda</option>
                <option value="bags-other">Otros bolsos</option>
                <option value="other">Otra aplicación</option>
              </select>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="quantity">Cantidad estimada</label>
                <input type="text" id="quantity" name="quantity" placeholder="e.g. 5,000 m / month" />
              </div>
              <div class="form-group">
                <label for="country">Su país *</label>
                <input type="text" id="country" name="country" required placeholder="e.g. Germany" />
              </div>
            </div>

            <div class="form-group">
              <label for="message">Cuéntenos sobre su proyecto</label>
              <textarea id="message" name="message" rows="5" placeholder="Dirección de color, requisitos de grosor, certificaciones específicas necesarias, plazos..."></textarea>
            </div>

            <div class="form-check">
              <input type="checkbox" id="sample" name="sample_request" value="yes" />
              <label for="sample">Me gustaría recibir un muestrario físico</label>
            </div>

            <button type="submit" class="btn-primary btn-submit">Enviar Consulta →</button>

            <p class="form-note">Solo lo contactamos sobre su consulta. Sin boletines, sin spam.</p>

            <div class="form-success" id="formSuccess" style="display:none;">
              <p>✓ Message received. We'll be in touch within one business day.</p>
            </div>
          </form>
        </div>

